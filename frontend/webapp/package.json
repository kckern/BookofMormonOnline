    "react-audio-player": "^0.17.0",
    "react-bootstrap-sweetalert": "^5.2.0",
    "react-bootstrap-switch": "^15.5.3",
    "react-calendar-heatmap": "^1.10.0",
    "react-circular-progressbar": "^2.2.0",
    "react-confetti": "^6.4.0",
    "react-cropper": "^2.1.8",
