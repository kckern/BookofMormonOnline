    "yet-another-react-lightbox": "^3.32.2"
  },
  "scripts": {
    "prestart": "node scripts/gen-features.js",
    "prebuild": "node scripts/gen-features.js",
    "start": "vite",
    "build": "vite build",
    "postbuild": "node scripts/stamp-sw-version.js",
    "test": "vitest run",
    "lint": "eslint src --ext .js,.jsx --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/*.spec.*\"",
    "compile-sass": "node-sass ./src/assets/scss/paper-dashboard.scss src/assets/css/paper-dashboard.css",
    "minify-sass": "node-sass ./src/assets/scss/paper-dashboard.scss src/assets/css/paper-dashboard.min.css --output-style compressed",
    "map-sass": "node-sass ./src/assets/scss/paper-dashboard.scss src/assets/css/paper-dashboard.css --source-map true",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/types": "^7.23.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "babel-polyfill": "^6.26.0",
    "babel-preset-react-app": "^10.1.0",
    "buffer": "^6.0.3",
    "camelcase": "^6.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "http-proxy-middleware": "^3.0.5",
    "jest-environment-jsdom": "^27.5.1",
    "js-yaml": "^4.3.2",
    "jsdom": "^27.4.0",
    "process": "^0.11.10",
    "sass": "^1.105.0",
    "stream": "^0.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "eslintConfig": {
    "root": true,
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "env": {
      "browser": true,
      "es2022": true
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "plugins": [
      "react",
      "react-hooks",
      "jsx-a11y"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:react/jsx-runtime",
      "plugin:jsx-a11y/recommended"
    ],
    "rules": {
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "warn",
      "react/prop-types": "off",
      "no-unused-vars": [
        "warn",
        {
          "args": "none",
          "ignoreRestSiblings": true
        }
      ],
      "jsx-a11y/click-events-have-key-events": "warn",
      "jsx-a11y/alt-text": "warn",
      "jsx-a11y/no-static-element-interactions": "warn",
      "jsx-a11y/no-noninteractive-element-interactions": "warn",
      "jsx-a11y/anchor-is-valid": "warn",
      "jsx-a11y/no-autofocus": "warn",
      "jsx-a11y/label-has-associated-control": "warn",
      "jsx-a11y/media-has-caption": "warn",
      "jsx-a11y/no-noninteractive-element-to-interactive-role": "warn",
      "jsx-a11y/iframe-has-title": "warn",
      "jsx-a11y/heading-has-content": "warn",
      "jsx-a11y/no-redundant-roles": "warn",
      "react/no-unknown-property": "warn",
      "no-empty": "warn",
      "no-useless-escape": "warn",
      "no-extra-semi": "warn",
      "react/jsx-key": "warn",
      "no-unsafe-optional-chaining": "warn",
      "no-unreachable": "warn",
      "no-mixed-spaces-and-tabs": "warn",
      "react/no-unescaped-entities": "warn",
      "jsx-a11y/no-noninteractive-tabindex": "warn",
      "no-extra-boolean-cast": "warn",
      "no-case-declarations": "warn",
      "no-constant-condition": "warn",
      "jsx-a11y/interactive-supports-focus": "warn",
      "no-empty-pattern": "warn",
      "no-prototype-builtins": "warn",
      "react/display-name": "warn",
      "react/jsx-no-target-blank": "warn"
    },
    "globals": {
      "global": "readonly",
      "process": "readonly"
    }
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
