# Messaging / study-group chat feature flag (green-field messaging backend).
# Resolved at RUNTIME (see src/models/featureFlags.js) so ONE build can be ON for a
# staging subdomain and OFF for prod. Enabled when EITHER:
#   1. REACT_APP_USE_MESSENGER=true (force-on everywhere — local dev / dedicated build), OR
#   2. the hostname matches REACT_APP_MESSENGER_HOSTS (default 'staging' → staging.* is on).
# Prod stays off by leaving the build flag false and not serving prod from a messaging host.
REACT_APP_USE_MESSENGER=false
# Comma-separated host substrings that auto-enable messaging at runtime (default 'staging').
# e.g. "staging,beta" or a specific host "messaging.bookofmormon.online".
REACT_APP_MESSENGER_HOSTS=staging

# API URL for the Messenger backend (optional - defaults to window.location.origin)
# REACT_APP_API_URL=https://api.bookofmormon.online

# Google OAuth Client ID
REACT_APP_GOOGLE_CLIENT_ID=

# Profile image CDN base URL — must match the backend's S3_PUBLIC_URL.
# Defaults to https://assets.bookofmormon.online if unset.
REACT_APP_PROFILE_IMAGE_BASE_URL=

# PassageNotes panels (Commentary / People / Places / Images / Chiasmus / References).
# Off by default — perf and design improvements still needed before primetime.
# Set to 'true' to render and fetch them in the Read view.
REACT_APP_ENABLE_PASSAGE_NOTES=false
