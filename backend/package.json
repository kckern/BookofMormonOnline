{
  "name": "bom-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Green-field GraphQL backend for Book of Mormon Online (spec: docs/specs/2026-06-09-greenfield-backend.md)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "codegen:db": "kysely-codegen --dialect mysql --out-file codegen/db.d.ts",
    "codegen:graphql": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.69",
    "@aws-sdk/client-cloudfront": "^3.1066.0",
    "@aws-sdk/client-s3": "^3.1066.0",
    "@envelop/core": "^5.5.1",
    "@fastify/rate-limit": "^11.1.0",
    "@mastra/core": "^1.41.0",
    "@mastra/qdrant": "^1.0.2",
    "@qdrant/js-client-rest": "^1.18.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "ai": "^6.0.201",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "graphql": "^16.9.0",
    "graphql-type-json": "^0.3.2",
    "graphql-yoga": "^5.10.0",
    "kysely": "^0.27.5",
    "mysql2": "^3.11.5",
    "nanoid": "^5.1.11",
    "openai": "^6.42.0",
    "pino": "^9.5.0",
    "redis": "^6.0.0",
    "scripture-guide": "^1.0.93",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-resolvers": "^4.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "kysely-codegen": "^0.17.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
