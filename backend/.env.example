# Copy to backend/.env (gitignored — repo is public, NEVER commit the real file).
# Dev values come from the host's Infisical-loaded runtime env ($XDG_RUNTIME_DIR/bom-dev.env).
PORT=5006
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=bom_prd
# kysely-codegen reads DATABASE_URL: mysql://user:pass@host:port/db
DATABASE_URL=
# 1 = suppress user writes (dev default); 0 only on prod-like deployments
SANDBOX=1
LOG_LEVEL=info

# ── Transactional email ────────────────────────────────────────────────────
# Provider SDK code lives only in src/mail/adapters. Sending is fail-closed.
MAIL_PROVIDER=console
MAIL_FROM=
MAIL_REGION=us-west-2
MAIL_CONFIGURATION_SET=bom-transactional
MAIL_SENDING_ENABLED=false
MAIL_SECURITY_ENABLED=false
MAIL_NOTIFICATIONS_ENABLED=false
MAIL_EVENT_QUEUE_URL=
MAIL_WORKER_INTERVAL_MS=1000
MAIL_SENDS_PER_SECOND=10
MAIL_MAX_TRANSACTIONAL_PER_RECIPIENT_HOUR=3
MAIL_MAX_NOTIFICATIONS_PER_USER_HOUR=3
MAIL_MAX_NOTIFICATIONS_PER_USER_DAY=8
MAIL_RATE_LIMIT_SECRET=
MAIL_UNSUBSCRIBE_SECRET=
# Optional notification email is opt-in; non-production sends require this list.
MAIL_NONPROD_ALLOWLIST=

# ── Messaging platform (Sendbird replacement) ──────────────────────────────
# Cutover kill-switch: anything but "false" → realtime on (default). "false" → GraphQL only.
MESSENGER_ENABLED=
# Real-time fan-out across instances. Unset → single-instance socket.io (dev).
REDIS_URL=
# Integration tests: a fixed bot reply (bypasses OpenAI) for deterministic bot-reply tests.
STUB_LLM_REPLY=
# Bots may open a socket with this shared token (their bom_user_id is null).
MESSENGER_BOT_TOKEN=
# Bot AI auto-responder (provider-agnostic; OpenAI is the default adapter).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Token-gated messaging tests — a live bom_user_token for a member user (suite skips if unset).
MESSENGER_TEST_TOKEN=
# Channel the test token's user belongs to (for invite-path tests); leave empty to skip.
MESSENGER_TEST_CHANNEL=

# ── Profile-image upload (uploadProfileImage → S3) ─────────────────────────
# Required for real uploads (sandbox skips S3). AWS creds via the standard provider
# chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION, or instance role).
S3_BUCKET=
# Public avatar base — MUST match the frontend REACT_APP_PROFILE_IMAGE_BASE_URL.
S3_PUBLIC_URL=https://assets.bookofmormon.online
# Optional: invalidate the avatar path after upload.
CLOUDFRONT_DISTRIBUTION_ID=

# --- Search / RAG (Qdrant) ---
# SEARCH_BACKEND: 'qdrant' to use the vector index, 'like' to force the legacy MySQL LIKE.
SEARCH_BACKEND=like
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
SEARCH_EMBED_MODEL=text-embedding-3-small
