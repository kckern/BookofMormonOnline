# RETIRED (do not enable), 2026-10-31: deploys are CI -> SSM only; this ran without BOM_IMAGE and redeployed a stale desired-image pin.
[Unit]
Description=Poll for a new Book of Mormon Online production image

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
Persistent=true
Unit=bom-deploy.service

[Install]
WantedBy=timers.target
