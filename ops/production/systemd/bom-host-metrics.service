[Unit]
Description=Publish Book of Mormon Online host metrics to CloudWatch
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/bom-publish-host-metrics
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
