# Copy to tests/.env.test (gitignored — repo is public, NEVER commit the real file).
# The test user exists only for this suite; mutations run against it.
# CONSTRAINT: the backend's signup (cleanUsername, src/resolvers/BomUser.ts) stores the
# username as the EMAIL PREFIX when an email is supplied — TEST_USERNAME must equal the
# part of TEST_EMAIL before the @, or signin will never match the user signup created.
TEST_USERNAME=bomtest+regression
TEST_PASSWORD=<generate: openssl rand -hex 12>
TEST_SESSION_TOKEN=<generate: openssl rand -hex 16>
TEST_NAME=Regression Test
TEST_EMAIL=bomtest+regression@kckern.com
TEST_ZIP=84604
